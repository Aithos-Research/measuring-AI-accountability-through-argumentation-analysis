# Python byte-code and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.cache/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# API credentials (never commit)
.env
.env.local
*.key

# Inspect AI run cache (regenerated on each run)
.inspect_cache/
.cache_inspect/

# Local exploratory outputs from the analysis pipeline.
# The canonical paper data is whitelisted below; everything else is ignored.
logs/deliberative_justification_v2/_*
logs/deliberative_justification_v2/*/cot/
logs/deliberative_justification_v2/*/reasoning/_no_gpt/

# --- whitelist the canonical paper data ---
# Reasoning panel (post-curation) — includes _no_gpt scheme analyses.
!logs/deliberative_justification_v2/20260527_combined_panels_curation/
!logs/deliberative_justification_v2/20260527_combined_panels_curation/**

# CoT panel (combined 9-models run — the 2 CoT-only models' analyses).
!logs/deliberative_justification_v2/20260522_combined_9models/
!logs/deliberative_justification_v2/20260522_combined_9models/**

# Raw Inspect-AI .eval traces are NOT tracked (1.2 GB).
# The cleaned, post-curation data is in `samples.json` under each panel and
# the analysis CSVs/PNGs alongside. Every raw .eval is inventoried in
# `eval_files_manifest.json` at the repo root so reviewers can trace lineage.
logs/**/eval_files/
